{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/composition/policy-fabric-cancellation-binding-tier2-binding.v1.json",
  "title": "PolicyFabric Cancellation Binding — Tier 2 Invariant Binding",
  "description": "Doctrine-only schema binding PolicyFabric cancellation-binding compositions to ProCybernetica Tier 2 invariant declared modes. Opaque hashes only; no runtime cancellation execution, break-glass resolution, cross-plane cancellation propagation, fail-closed runtime attestation, or admission decision at composition time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_id",
    "composition_kind",
    "binding_doctrine_version",
    "cancellation_binding_refs",
    "cancellation_target_refs",
    "cancellation_evidence_refs",
    "break_glass_authority_refs",
    "fail_closed_propagation_targets",
    "bound_modes",
    "non_claims"
  ],
  "properties": {
    "composition_id": {"const": "policy_fabric.cancellation_binding"},
    "composition_kind": {"const": "cancellation_binding_composition"},
    "binding_doctrine_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$",
      "description": "Doctrine version under which this binding is declared. Pins the binding to a specific Tier 2 invariant binding revision."
    },
    "cancellation_binding_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cancellation_ref"}},
    "cancellation_target_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cancellation_ref"}},
    "cancellation_evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cancellation_ref"}},
    "break_glass_authority_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cancellation_ref"}},
    "fail_closed_propagation_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plane_target_ref"}},
    "bound_modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_integration",
        "authority_scope_analysis",
        "non_claim_analysis",
        "monitor_independence_analysis",
        "evidence_freshness_analysis"
      ],
      "properties": {
        "receipt_integration": {"const": "hash_bound_reference"},
        "authority_scope_analysis": {"const": "declared_scope_lattice_v1"},
        "non_claim_analysis": {"const": "explicit_propagate_or_resolve_v1"},
        "monitor_independence_analysis": {"const": "declared_monitor_independence_v1"},
        "evidence_freshness_analysis": {"const": "declared_evidence_freshness_v1"}
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_runtime_receipt_lookup",
          "no_runtime_non_claim_verification",
          "no_runtime_monitor_attestation",
          "no_timestamp_authenticity",
          "opaque_hashes_not_resolved",
          "no_runtime_cancellation_execution",
          "no_runtime_break_glass_resolution",
          "no_cross_plane_cancellation_runtime_propagation",
          "no_fail_closed_runtime_attestation",
          "no_admission_decision_at_composition"
        ]
      }
    }
  },
  "$defs": {
    "cancellation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_kind", "ref_id", "opaque_hash"],
      "properties": {
        "ref_kind": {
          "type": "string",
          "enum": [
            "cancellation_binding",
            "cancellation_target",
            "cancellation_evidence",
            "break_glass_authority"
          ]
        },
        "ref_id": {"type": "string"},
        "opaque_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Opaque content-addressed reference. This binding schema does not resolve the hash at validation time."
        }
      }
    },
    "plane_target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane_id", "target_id", "opaque_hash"],
      "properties": {
        "plane_id": {
          "type": "string",
          "enum": [
            "superconscious",
            "procybernetica",
            "sociosphere",
            "policy-fabric",
            "agentplane",
            "sourceos-syncd",
            "model-governance-ledger",
            "prophet-platform",
            "other"
          ]
        },
        "target_id": {"type": "string"},
        "opaque_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Opaque content-addressed reference for the fail-closed propagation target. This binding schema does not verify propagation at validation time."
        }
      }
    }
  }
}
