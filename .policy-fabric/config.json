    ".policy-fabric/local-notes/**",
    ".agentplane/policy/incidents.md"
  ],
  "archiveProtectedPaths": [
    "archive/prior-reference/**"
  ],
  "doctorCommand": "python scripts/doctor.py",
  "reconcileCommand": "python scripts/reconcile.py",
  "bundleCommand": "python scripts/build_dist_bundle.py",
  "doctorReportPath": "docs/reports/doctor_latest.md",
  "validationReportPath": "docs/reports/validation_report_latest.json",
  "agentplaneBridgeContract": ".policy-fabric/agentplane_bridge.json",
  "agentplaneProbeCommand": "python scripts/agentplane_probe.py",
  "agentplaneProbeReportPath": "docs/reports/agentplane_probe_latest.json",
  "branchPolicyContract": ".policy-fabric/branch_policy.json",
  "branchAuditCommand": "python scripts/branch_audit.py",
  "branchAuditReportPath": "docs/reports/branch_audit_latest.json"
}
