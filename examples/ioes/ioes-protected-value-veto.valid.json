{
  "schema_version": "0.1",
  "profile_id": "policy://ioes/protected-value/stewarded-learning-artifact.preview",
  "description": "Preview-scope IOES veto profile for stewarded learning artifact promotion and projection.",
  "scope": {
    "action_families": [
      "learning.artifact.promote",
      "identity.projection.emit",
      "stewardship.edge.assign"
    ],
    "risk_tier": "human_impacting",
    "human_impacting": true
  },
  "protected_values": {
    "human_dignity": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "policy_snapshot_ref"
      ],
      "repair_action": "Add non-reduction statement and projection-loss disclosure."
    },
    "consent": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "consent_receipt"
      ],
      "repair_action": "Collect scoped consent before outward projection."
    },
    "stewardship_without_ownership": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "keeper_log_ref",
        "authority_ref"
      ],
      "repair_action": "Add keeper log and authority reference; do not infer ownership."
    },
    "developmental_integrity": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "review_record_ref",
        "evidence_ref"
      ],
      "repair_action": "Require review before developmental state mutation."
    },
    "ecological_accountability": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "gaia_dependency_ref"
      ],
      "repair_action": "Attach material dependency context or mark unknown."
    },
    "provenance": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "evidence_ref"
      ],
      "repair_action": "Attach evidence or mark claim candidate-only."
    },
    "succession": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "succession_rule_ref"
      ],
      "repair_action": "Add succession posture before canon promotion."
    },
    "agent_boundedness": {
      "enabled": true,
      "veto_capable": true,
      "required_evidence": [
        "authority_ref",
        "replay_evidence_ref"
      ],
      "repair_action": "Bind agent action to grant and replay evidence."
    }
  },
  "decision_policy": {
    "missing_consent": "deny",
    "missing_authority": "deny",
    "missing_evidence": "repair",
    "developmental_state_mutation": "review",
    "stewardship_transfer": "review",
    "outward_projection": "allow_with_consent",
    "model_only_evidence": "candidate_only",
    "satisfied": "allow_with_context"
  },
  "fail_closed_defaults": {
    "deny_on_missing_consent": true,
    "deny_on_missing_authority": true,
    "deny_on_unreplayable_human_impact": true,
    "candidate_only_for_model_only_canonical_claims": true
  },
  "exception_policy": {
    "allowed": true,
    "requires_authority": true,
    "requires_expiration": true,
    "requires_review_evidence": true,
    "max_duration_days": 30
  },
  "non_claims": [
    "This profile defines policy posture, not runtime enforcement by itself.",
    "This profile does not make a digital twin equivalent to a human subject."
  ]
}
