{
  "apiVersion": "policy.socioprophet.dev/v1",
  "kind": "LatticeRuntimePromotionPolicyPack",
  "metadata": {
    "name": "lattice-runtime-promotion-policy",
    "version": "0.1.0",
    "description": "Policy decisions that consume RuntimePromotionManifest evidence for Lattice RuntimeAsset promotion."
  },
  "spec": {
    "sourceOfTruth": "SocioProphet/policy-fabric",
    "trackingRefs": [
      "SocioProphet/prophet-platform#291",
      "SocioProphet/lattice-forge#12",
      "SocioProphet/sociosphere#242"
    ],
    "subjectKinds": [
      "RuntimePromotionManifest",
      "RuntimeAsset",
      "RuntimePromotionDecision",
      "RuntimePromotionGate"
    ],
    "actions": [
      "evaluate-runtime-promotion",
      "allow-dev-runtime-promotion",
      "block-stable-runtime-promotion",
      "request-stable-runtime-review"
    ],
    "runtimePromotionManifestRef": "runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0",
    "runtimeRefs": [
      "runtime-asset:prophet-python-ml:0.1.0",
      "runtime-asset:prophet-ray-ml:0.1.0",
      "runtime-asset:prophet-beam-dataops:0.1.0"
    ],
    "requiredGeneratedEvidence": [
      "RuntimeAsset",
      "SBOM",
      "scan-report",
      "attestation",
      "signature",
      "RuntimePromotionManifest"
    ],
    "requiredStableEvidence": [
      "external-scanner-evidence",
      "external-signing-authority-evidence",
      "human-approval"
    ],
    "promotionGates": {
      "devRuntimePromotion": [
        "RuntimePromotionManifest-present",
        "RuntimeAsset-present",
        "SBOM-present",
        "scan-report-pass",
        "attestation-present",
        "signature-present",
        "promotion.channel=dev"
      ],
      "stableRuntimePromotion": [
        "RuntimePromotionManifest-present",
        "external-scanner-evidence-present",
        "external-signing-authority-evidence-present",
        "human-approval-present",
        "promotion.channel=stable"
      ]
    },
    "decisions": [
      {
        "decisionId": "decision:lattice:runtime-promotion:python-ml:dev-allow",
        "subjectRef": "runtime-asset:prophet-python-ml:0.1.0",
        "subjectKind": "RuntimePromotionManifest",
        "action": "allow-dev-runtime-promotion",
        "result": "allow",
        "because": [
          "RuntimePromotionManifest-present",
          "generated RuntimeAsset evidence present",
          "generated SBOM scan attestation and signature evidence present",
          "promotion.channel=dev"
        ],
        "evidenceRefs": ["runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0"]
      },
      {
        "decisionId": "decision:lattice:runtime-promotion:ray-ml:dev-allow",
        "subjectRef": "runtime-asset:prophet-ray-ml:0.1.0",
        "subjectKind": "RuntimePromotionManifest",
        "action": "allow-dev-runtime-promotion",
        "result": "allow",
        "because": [
          "RuntimePromotionManifest-present",
          "generated RuntimeAsset evidence present",
          "generated SBOM scan attestation and signature evidence present",
          "promotion.channel=dev"
        ],
        "evidenceRefs": ["runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0"]
      },
      {
        "decisionId": "decision:lattice:runtime-promotion:beam-dataops:dev-allow",
        "subjectRef": "runtime-asset:prophet-beam-dataops:0.1.0",
        "subjectKind": "RuntimePromotionManifest",
        "action": "allow-dev-runtime-promotion",
        "result": "allow",
        "because": [
          "RuntimePromotionManifest-present",
          "generated RuntimeAsset evidence present",
          "generated SBOM scan attestation and signature evidence present",
          "promotion.channel=dev"
        ],
        "evidenceRefs": ["runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0"]
      },
      {
        "decisionId": "decision:lattice:runtime-promotion:stable:block-without-external-evidence",
        "subjectRef": "runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0",
        "subjectKind": "RuntimePromotionManifest",
        "action": "block-stable-runtime-promotion",
        "result": "deny",
        "because": [
          "external-scanner-evidence missing",
          "external-signing-authority-evidence missing",
          "human-approval missing",
          "stable promotion default is blocked"
        ],
        "evidenceRefs": ["runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0"]
      },
      {
        "decisionId": "decision:lattice:runtime-promotion:stable:review-required",
        "subjectRef": "runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0",
        "subjectKind": "RuntimePromotionManifest",
        "action": "request-stable-runtime-review",
        "result": "review-required",
        "because": [
          "stable promotion requires external scanner evidence",
          "stable promotion requires external signing authority evidence",
          "stable promotion requires human approval"
        ],
        "evidenceRefs": ["runtime-promotion-manifest:lattice-runtime-promotion-manifest:0.1.0"]
      }
    ],
    "nonNegotiables": {
      "runtimeAssetOwner": "SocioProphet/lattice-forge",
      "policyDecisionOwner": "SocioProphet/policy-fabric",
      "topologyGovernor": "SocioProphet/sociosphere",
      "stablePromotionDefault": "blocked",
      "mustNotAllowStablePromotionWithGeneratedEvidenceOnly": true,
      "mustNotBypassPolicyFabric": true
    }
  }
}
