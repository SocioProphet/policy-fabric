{
  "schemaVersion": "policy-fabric.sourceos-capability-decision-policy.v1",
  "policyId": "sourceos.capability_decision.baseline",
  "status": "active",
  "owner": "SocioProphet/PolicyFabric + SourceOS-Linux",
  "purpose": "Invalid fixture: remote telemetry denial was removed and must be rejected by semantic validation.",
  "defaultDecision": "deny",
  "serviceClasses": [
    {
      "serviceClass": "sourceos.app.browser",
      "authorityDomain": "app",
      "requiredCapabilities": [
        "browser.profile.read",
        "browser.renderer.spawn",
        "browser.gpu.spawn",
        "network.client.web",
        "diagnostics.local.incident",
        "events.canonical.emit"
      ],
      "optionalCapabilities": [
        "ai.inference.local",
        "security.reputation.query",
        "telemetry.emit.local",
        "agent.browser.sidecar"
      ],
      "deniedCapabilities": [
        "ipc.lookup.cloud.sync.ambient",
        "identity.product.upstream_leak",
        "launch.inherit_user_shell"
      ],
      "emitsCanonicalEvents": true,
      "requiresIncidentBundle": true
    },
    {
      "serviceClass": "sourceos.developer.terminal",
      "authorityDomain": "developer",
      "requiredCapabilities": [
        "developer.session.provenance",
        "events.canonical.emit",
        "diagnostics.local.incident"
      ],
      "optionalCapabilities": [
        "developer.command.hash",
        "developer.project_scope.enable",
        "agent.local.dispatch"
      ],
      "deniedCapabilities": [
        "telemetry.emit.remote.default",
        "privilege.escalation.untraced",
        "launch.inherit_user_shell.unbounded"
      ],
      "emitsCanonicalEvents": true,
      "requiresIncidentBundle": true
    }
  ],
  "capabilityRules": {
    "allow": [
      {
        "capability": "events.canonical.emit",
        "serviceClass": "sourceos.app.browser",
        "decision": "allow",
        "explanationCode": "CAPABILITY_ALLOWED_CANONICAL_EVENT_EMIT",
        "notes": "Browser products must emit local canonical events."
      },
      {
        "capability": "telemetry.emit.local",
        "serviceClass": "sourceos.app.browser",
        "decision": "audit",
        "explanationCode": "CAPABILITY_AUDIT_LOCAL_TELEMETRY",
        "notes": "Local telemetry is audit-only."
      },
      {
        "capability": "developer.session.provenance",
        "serviceClass": "sourceos.developer.terminal",
        "decision": "allow",
        "explanationCode": "CAPABILITY_ALLOWED_DEVELOPER_SESSION_PROVENANCE",
        "notes": "Developer sessions need local provenance receipts."
      }
    ],
    "deny": [
      {
        "capability": "identity.product.upstream_leak",
        "serviceClass": "sourceos.app.browser",
        "decision": "deny",
        "explanationCode": "CAPABILITY_DENIED_PRODUCT_IDENTITY_LEAK",
        "notes": "Upstream product identity leakage is denied."
      },
      {
        "capability": "launch.inherit_user_shell",
        "serviceClass": "sourceos.app.browser",
        "decision": "deny",
        "explanationCode": "CAPABILITY_DENIED_INHERIT_USER_SHELL",
        "notes": "Packaged apps must use hermetic launch manifests."
      },
      {
        "capability": "privilege.escalation.untraced",
        "serviceClass": "sourceos.developer.terminal",
        "decision": "deny",
        "explanationCode": "CAPABILITY_DENIED_UNTRACED_PRIVILEGE_ESCALATION",
        "notes": "Privileged developer actions require receipts."
      }
    ],
    "requirePolicyTrace": true
  },
  "telemetryRules": {
    "remoteDefault": "deny",
    "localDefault": "audit",
    "requiresExplicitGrant": true,
    "canonicalEventRequired": true
  },
  "identityRules": {
    "upstreamProductIdentityLeak": "deny",
    "engineProvenanceAllowed": true,
    "productSurfaceIdentityRequired": true
  },
  "launchRules": {
    "inheritUserShell": "deny",
    "duplicatePathEntries": "deny",
    "developerPathDefault": "warn",
    "manifestRequiredForApps": true
  },
  "trustRules": {
    "defaultTrustMode": "local_first",
    "silentRemoteTrustLookup": "deny",
    "networkLookupRequiresPolicy": true
  },
  "eventRules": {
    "canonicalEventRequired": true,
    "operatorNarrativeRequired": true,
    "causalityRequired": true,
    "expectedDenialsSeverityMax": "notice"
  },
  "auditRules": {
    "requireDecisionId": true,
    "requireExplanationCode": true,
    "requireActor": true,
    "requireSubject": true,
    "requireRetentionClass": true
  }
}
