{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/policy-fabric/schemas/policy_fabric_capability_catalog_v1.schema.json",
  "title": "Policy Fabric Capability Catalog v1",
  "description": "Governed provider and capability authorization catalog used during semantic validation and release assembly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "providers",
    "capabilities"
  ],
  "properties": {
    "apiVersion": {
      "const": "policy.fabric.catalog/v1"
    },
    "kind": {
      "const": "CapabilityCatalog"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "x-semanticValidationRules": [
    "providers[].id MUST be unique within the catalog.",
    "capabilities[].id MUST be unique within the catalog.",
    "capabilities[].provider MUST resolve to an existing providers[].id.",
    "capabilities[].transformType MUST be allowed by the referenced provider.",
    "Approved policies SHOULD only reference providers and capabilities permitted for their rollout tenants and regions."
  ],
  "$defs": {
    "idString": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "updatedAt",
        "owner"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/idString"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerClass",
        "allowedTransformTypes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "providerClass": {
          "enum": [
            "crypto",
            "tokenVault",
            "redaction",
            "hash",
            "mixed"
          ]
        },
        "allowedTransformTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "redact",
              "encrypt",
              "tokenize",
              "formatPreservingEncrypt",
              "formatPreservingTokenize",
              "partialMask",
              "hash",
              "decrypt",
              "detokenize"
            ]
          }
        },
        "allowedTenants": {
          "$ref": "#/$defs/stringArray"
        },
        "allowedRegions": {
          "$ref": "#/$defs/stringArray"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "transformType"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/idString"
        },
        "provider": {
          "$ref": "#/$defs/idString"
        },
        "transformType": {
          "enum": [
            "redact",
            "encrypt",
            "tokenize",
            "formatPreservingEncrypt",
            "formatPreservingTokenize",
            "partialMask",
            "hash",
            "decrypt",
            "detokenize"
          ]
        },
        "reidentification": {
          "type": "boolean",
          "default": false
        },
        "allowedTenants": {
          "$ref": "#/$defs/stringArray"
        },
        "allowedRegions": {
          "$ref": "#/$defs/stringArray"
        },
        "requiredLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
