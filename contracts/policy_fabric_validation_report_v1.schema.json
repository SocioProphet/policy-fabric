{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/policy-fabric/schemas/policy_fabric_validation_report_v1.schema.json",
  "title": "Policy Fabric Validation Report v1",
  "description": "Machine-readable validation evidence for authored policy, compiled plan, interface, and release pack checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "subject",
    "summary",
    "checks"
  ],
  "properties": {
    "apiVersion": {
      "const": "policy.fabric.validation/v1"
    },
    "kind": {
      "const": "ValidationReport"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "generator"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "policy",
            "plan",
            "releasePack",
            "openapi"
          ]
        },
        "ref": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkCount",
        "failCount"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "checkCount": {
          "type": "integer",
          "minimum": 0
        },
        "failCount": {
          "type": "integer",
          "minimum": 0
        },
        "warnCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "message": {
            "type": "string"
          },
          "artifactRef": {
            "type": "string"
          }
        }
      }
    }
  }
}
