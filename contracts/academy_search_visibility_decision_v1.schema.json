{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/policy-fabric/academy_search_visibility_decision_v1.schema.json",
  "title": "AcademySearchVisibilityDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_decision_id", "request_id", "subject_ref", "action_ref", "decision", "required_gates", "reason"],
  "properties": {
    "policy_decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "action_ref": {"type": "string", "const": "action://academy/search/read"},
    "decision": {"type": "string", "enum": ["allow", "deny"]},
    "required_gates": {
      "type": "array",
      "items": {"type": "string", "enum": ["actor_gate", "workspace_gate", "jurisdiction_gate", "policy_tag_gate", "evidence_gate"]}
    },
    "reason": {"type": "string", "minLength": 1},
    "visibility_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_id": {"type": "string"},
        "workspace_id": {"type": "string"},
        "jurisdiction_id": {"type": "string"}
      }
    },
    "validation_evidence": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
